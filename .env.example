DATABASE_URL=postgresql://jobrunner:jobrunner@localhost:5432/jobrunner
CONCURRENCY_LIMIT=2
# LEASE_SECONDS should be at least 4-5x HEARTBEAT_INTERVAL (Engine's
# constructor enforces a hard floor of 3x) -- a thinner ratio leaves too
# little margin for an ordinary scheduling delay to make a live worker look
# dead. See DECISIONS.md, "lease-to-heartbeat ratio must leave room for
# several missed renewals".
LEASE_SECONDS=50
HEARTBEAT_INTERVAL=10
MAX_ATTEMPTS=3
